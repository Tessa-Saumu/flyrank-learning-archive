---
/**
 * FilterBar.astro — restrained filters (DESIGN_SPEC §40).
 * Primary: ALL · AI FLUENCY · MACHINE LEARNING · CONCEPTS.
 * Secondary: CORE / SUPPORTING / REFERENCE (tier).
 *
 * Phase 1: server-rendered via query params (shareable URLs). The tier
 * filter is hidden when the concepts view is active (tier does not apply).
 *
 * V2 §14 (ARIA): the tier filters are real links (server-rendered filtering
 * must work without JavaScript and produce shareable URLs), so the semantic
 * model genuinely requires `<a>` elements. `aria-pressed` is only valid on
 * toggle buttons; the active tier is therefore conveyed with
 * `aria-current="true"`, which is valid on links.
 */
interface Props {
  track?: string;
  tier?: string;
  view?: string;
  basePath?: string;
}

const { track, tier, view = 'work', basePath = '/work/' } = Astro.props;

function q(params: Record<string, string | undefined>): string {
  const entries = Object.entries(params).filter(([, v]) => v !== undefined && v !== '');
  if (entries.length === 0) return basePath;
  const qs = new URLSearchParams(entries as [string, string][]);
  return `${basePath}?${qs.toString()}`;
}

const primary = [
  { label: 'All', href: q({}), active: view === 'work' && !track },
  { label: 'AI Fluency', href: q({ track: 'ai-fluency' }), active: view === 'work' && track === 'ai-fluency' },
  { label: 'Machine Learning', href: q({ track: 'machine-learning' }), active: view === 'work' && track === 'machine-learning' },
  { label: 'Concepts', href: q({ view: 'concepts' }), active: view === 'concepts' },
];

const tiers = [
  { label: 'Core', value: 'core' },
  { label: 'Supporting', value: 'supporting' },
  { label: 'Reference', value: 'reference' },
];
---

<nav class="filterbar" aria-label="Filters">
  <div class="filterbar__group filterbar__group--primary">
    {
      primary.map((item) => (
        <a
          href={item.href}
          class:list={['filterbar__item', 'filterbar__item--primary', { 'is-active': item.active }]}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </div>

  {
    view !== 'concepts' && (
      <div class="filterbar__group filterbar__group--tier" aria-label="Tier">
        <span class="filterbar__kicker" aria-hidden="true">Tier</span>
        {tiers.map((t) => (
          <a
            href={q({ track, tier: tier === t.value ? undefined : t.value })}
            class:list={['filterbar__item', 'filterbar__item--secondary', { 'is-active': tier === t.value }]}
            aria-current={tier === t.value ? 'true' : undefined}
          >
            {t.label}
          </a>
        ))}
      </div>
    )
  }
</nav>

<style>
  .filterbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-3) 0 var(--space-5);
    border-bottom: var(--rule);
    margin-bottom: var(--space-6);
  }

  .filterbar__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  /* V2 §1: the tier tabs are a labelled, tighter, visibly lighter cluster so
     they read as controls belonging to the section — not as more primary
     tabs continuing the same flat row. */
  .filterbar__group--tier {
    gap: var(--space-1);
    margin-left: var(--space-4);
  }

  .filterbar__kicker {
    font-size: var(--fs-metadata);
    font-weight: 500;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--text-faint);
    margin-right: var(--space-2);
  }

  .filterbar__item {
    font-size: var(--fs-metadata);
    font-weight: 500;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-dim);
    padding: var(--space-2) var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius-1);
    transition: color var(--motion-fast) var(--ease), border-color var(--motion-fast) var(--ease);
  }

  /* Primary tabs: heavier, slightly larger, chip-style active state. */
  .filterbar__item--primary {
    font-size: var(--fs-tab);
    font-weight: 600;
  }

  /* Secondary tabs: lighter weight and metadata size; the active state is a
     thin underline instead of the primary chip border. */
  .filterbar__item--secondary {
    font-weight: 400;
    padding: var(--space-2) var(--space-2);
  }

  .filterbar__item:hover {
    color: var(--text);
  }

  .filterbar__item--primary.is-active {
    color: var(--text);
    border-color: var(--rule-active);
  }

  .filterbar__item--secondary.is-active {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
</style>
