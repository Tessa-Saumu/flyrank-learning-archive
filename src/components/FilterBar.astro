---
/**
 * FilterBar.astro — restrained filters (DESIGN_SPEC §40).
 * Categories: ALL · AI FLUENCY · MACHINE LEARNING · CONCEPTS.
 *
 * Phase 1: server-rendered via query params (shareable URLs), so filtering
 * works without JavaScript and every filter state is shareable.
 *
 * V2 REVISION Phase 1 §6: the Tier filter (CORE / SUPPORTING / REFERENCE) has
 * been removed from the interface entirely. Work is filtered by its actual
 * categories only; no replacement tier control is offered, and no inactive
 * remnant of the old system is left in the DOM.
 */
interface Props {
  track?: string;
  view?: string;
  basePath?: string;
}

const { track, view = 'work', basePath = '/work/' } = Astro.props;

function q(params: Record<string, string | undefined>): string {
  const entries = Object.entries(params).filter(([, v]) => v !== undefined && v !== '');
  if (entries.length === 0) return basePath;
  const qs = new URLSearchParams(entries as [string, string][]);
  return `${basePath}?${qs.toString()}`;
}

const primary = [
  { label: 'All', href: q({}), active: view === 'work' && !track },
  { label: 'AI Fluency', href: q({ track: 'ai-fluency' }), active: view === 'work' && track === 'ai-fluency' },
  { label: 'Machine Learning', href: q({ track: 'machine-learning' }), active: view === 'work' && track === 'machine-learning' },
  { label: 'Concepts', href: q({ view: 'concepts' }), active: view === 'concepts' },
];
---

<nav class="filterbar" aria-label="Filters">
  <div class="filterbar__group filterbar__group--primary">
    {
      primary.map((item) => (
        <a
          href={item.href}
          class:list={['filterbar__item', 'filterbar__item--primary', { 'is-active': item.active }]}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </div>

</nav>

<style>
  .filterbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-3) 0 var(--space-5);
    border-bottom: var(--rule);
    margin-bottom: var(--space-6);
  }

  .filterbar__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .filterbar__item {
    font-size: var(--fs-metadata);
    font-weight: 500;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-dim);
    padding: var(--space-2) var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius-1);
    transition: color var(--motion-fast) var(--ease), border-color var(--motion-fast) var(--ease);
  }

  /* Category tabs: heavier, slightly larger, chip-style active state. */
  .filterbar__item--primary {
    font-size: var(--fs-tab);
    font-weight: 600;
  }

  .filterbar__item:hover {
    color: var(--text);
  }

  .filterbar__item--primary.is-active {
    color: var(--text);
    border-color: var(--rule-active);
  }
</style>
