---
/**
 * FilterBar.astro — restrained filters (DESIGN_SPEC §40).
 * Categories: ALL · AI FLUENCY · MACHINE LEARNING · CONCEPTS.
 *
 * V2 REVISION Phase 3 §15: Unified filtering across Home and Work.
 * Works with client-side interactive filtering without navigating away,
 * while preserving shareable URLs and no-JS server fallback.
 *
 * V2 REVISION Phase 1 §6 & Phase 3 §16: The Tier filter (CORE / SUPPORTING / REFERENCE)
 * and its terminology have been removed completely from the interface.
 * Work is filtered by actual categories only.
 */
interface Props {
  track?: string;
  view?: string;
  basePath?: string;
}

const { track, view = 'work', basePath = '/work/' } = Astro.props;

function q(params: Record<string, string | undefined>): string {
  const entries = Object.entries(params).filter(([, v]) => v !== undefined && v !== '');
  if (entries.length === 0) return basePath;
  const qs = new URLSearchParams(entries as [string, string][]);
  return `${basePath}?${qs.toString()}`;
}

const primary = [
  { label: 'All', href: q({}), track: 'all', active: view === 'work' && !track },
  { label: 'AI Fluency', href: q({ track: 'ai-fluency' }), track: 'ai-fluency', active: view === 'work' && track === 'ai-fluency' },
  { label: 'Machine Learning', href: q({ track: 'machine-learning' }), track: 'machine-learning', active: view === 'work' && track === 'machine-learning' },
  { label: 'Concepts', href: q({ view: 'concepts' }), view: 'concepts', active: view === 'concepts' },
];
---

<nav class="filterbar" data-filter-bar aria-label="Filters">
  <div class="filterbar__group filterbar__group--primary">
    {
      primary.map((item) => (
        <a
          href={item.href}
          class:list={['filterbar__item', 'filterbar__item--primary', { 'is-active': item.active }]}
          data-filter-item
          data-filter-track={item.track}
          data-filter-view={item.view}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .filterbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-3) 0 var(--space-5);
    border-bottom: var(--rule);
    margin-bottom: var(--space-6);
  }

  .filterbar__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .filterbar__item {
    font-size: var(--fs-metadata);
    font-weight: 500;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-dim);
    padding: var(--space-2) var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius-1);
    transition: color var(--motion-fast) var(--ease), border-color var(--motion-fast) var(--ease);
  }

  /* Category tabs: heavier, slightly larger, chip-style active state. */
  .filterbar__item--primary {
    font-size: var(--fs-tab);
    font-weight: 600;
  }

  .filterbar__item:hover {
    color: var(--text);
  }

  .filterbar__item--primary.is-active {
    color: var(--text);
    border-color: var(--rule-active);
  }
</style>
