---
/**
 * ArtifactPreview.astro — the single evidence renderer (DESIGN_SPEC §21–23,
 * §44, §56–57), extended for the V2 evidence panel (V2_IMPROVEMENT_SPEC §3–4).
 *
 * Three registry display modes (CONTENT_REGISTRY §3.1):
 *   - embed   — substantial stable artifacts. The initial HTML contains only a
 *               preview. `Show evidence` creates the heavy viewer on demand;
 *               the first-class fallback remains until an embed is chosen.
 *   - preview — compact technical card: title, one-sentence description, type,
 *               optional screenshot, evidence status, and a `Show evidence` path.
 *   - link    — administrative/source material: a simple labelled link row with
 *               a `Show evidence` fallback.
 *
 * Type support: PDF and video use the appropriate viewer when a URL is
 * supplied; the component keeps a single activation contract so additional
 * artifact types can be added without rewriting the modal.
 *
 * Honesty rule: until a real URL/screenshot is supplied, `url` is undefined and
 * the component renders the honest `partial` state (EVIDENCE: PARTIAL), never a
 * fake embed. Status is always shown with text, never colour alone (§25).
 */
import NotebookPreview from './NotebookPreview.astro';
import { evidenceStatusLabel } from '../lib/archive';
import { notebookForAssignment } from '../data/notebooks';
import type { Artifact, ArtifactLink, Assignment, EvidenceStatus } from '../data/types';

interface Props {
  artifact: Artifact;
  link?: ArtifactLink;
  evidenceStatus?: EvidenceStatus;
  /** The owning assignment, used to render per-assignment notebook previews. */
  assignment?: Assignment;
}

const { artifact, link, evidenceStatus = 'partial', assignment } = Astro.props;

const mode = link?.displayMode ?? 'preview';
const hasUrl = Boolean(artifact.url);
const notebook = assignment ? notebookForAssignment(assignment.id) : undefined;
const hostIsEmbeddable = artifact.type === 'live' || artifact.type === 'video' || artifact.type === 'pdf';
const srcForEmbed = artifact.embedUrl ?? artifact.url ?? '';

const roleLabel = link
  ? { produces: 'Produces', uses: 'Uses', documents: 'Documents', demonstrates: 'Demonstrates' }[
      link.role
    ]
  : undefined;

// The embed fallback contract (DESIGN_SPEC §57).
const fallbackLabel = `[artifact preview] · ${artifact.title} · This artifact opens externally.`;
const externalRel = 'noopener noreferrer';
---

{
  /* ---------- LINK mode: administrative/source material ---------- */
  mode === 'link' && (
    <div
      class="preview preview--link"
      data-artifact-link
      data-type={artifact.type}
      data-title={artifact.title}
      data-src={hasUrl ? srcForEmbed : ''}
    >
      <span class="preview__dot" aria-hidden="true"></span>
      <span class="preview__link-title">{artifact.title}</span>
      {
        hasUrl ? (
          <a class="preview__action" href={artifact.url} target="_blank" rel={externalRel}>
            Open <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="preview__action preview__action--pending" title="No artifact URL supplied yet">
            Link pending
          </span>
        )
      }
      <button class="preview__action preview__action--show" type="button" data-show-evidence>
        Show evidence
      </button>
      <span class="preview__status" data-status={evidenceStatus}>
        {evidenceStatusLabel(evidenceStatus)}
      </span>
      <p class="preview__pending" data-evidence-pending hidden>
        No evidence URL supplied yet. This item stays in preview until the owner supplies the asset.
      </p>
    </div>
  )
}

{
  /* ---------- EMBED mode (notebook): contained viewport, not an iframe ---------- */
  mode === 'embed' && notebook && (
    <NotebookPreview
      notebook={notebook}
      evidenceStatus={evidenceStatus}
      openUrl={artifact.embedUrl}
      githubUrl={artifact.url}
    />
  )
}

{
  /* ---------- EMBED mode (live/video/pdf): lazy viewer on demand ---------- */
  mode === 'embed' && !notebook && (
    <article
      class="preview preview--embed"
      data-artifact-embed
      data-src={hasUrl ? srcForEmbed : ''}
      data-type={artifact.type}
      data-title={artifact.title}
    >
      <div class="preview__bar">
        <span class="preview__type">{artifact.type}</span>
        {roleLabel && <span class="preview__role">{roleLabel}</span>}
      </div>

      <div class="preview__body">
        {
          artifact.previewImage ? (
            <img
              class="preview__image"
              src={artifact.previewImage}
              alt={artifact.title}
              loading="lazy"
            />
          ) : (
            <div class="preview__thumbnail" aria-hidden="true">
              <span class="preview__thumbnail-type">{artifact.type}</span>
              <span class="preview__thumbnail-label">Preview</span>
            </div>
          )
        }
        <h3 class="preview__title">{artifact.title}</h3>
        <p class="preview__desc">{artifact.description}</p>
        <div class="preview__foot">
          <span class="preview__status" data-status={evidenceStatus}>
            <span class="preview__dot" aria-hidden="true"></span>
            {evidenceStatusLabel(evidenceStatus)}
          </span>
          <button class="preview__action preview__action--filled" type="button" data-show-evidence>
            Show evidence
          </button>
        </div>
      </div>

      <div class="embed-fallback" data-embed-fallback>
        <p class="embed-fallback__note">{fallbackLabel}</p>
        <div class="preview__foot">
          <span class="preview__status" data-status={evidenceStatus}>
            <span class="preview__dot" aria-hidden="true"></span>
            {evidenceStatusLabel(evidenceStatus)}
          </span>
          <span class="preview__action preview__action--filled" data-open-artifact>
            {
              hasUrl ? (
                <a href={artifact.url} target="_blank" rel={externalRel}>
                  Open artifact <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="preview__action--pending" title="No artifact URL supplied yet">
                  Open artifact
                </span>
              )
            }
          </span>
        </div>
      </div>

      <div class="preview__embed-target" data-evidence-target hidden></div>
      <p class="preview__pending" data-evidence-pending hidden>
        No evidence URL supplied yet. This item stays in preview until the owner supplies the asset.
      </p>
    </article>
  )
}

{
  /* ---------- PREVIEW mode: compact technical evidence card ---------- */
  mode === 'preview' && (
    <article
      class="preview"
      data-artifact-preview
      data-src={hasUrl && hostIsEmbeddable ? srcForEmbed : ''}
      data-type={artifact.type}
      data-title={artifact.title}
    >
      <div class="preview__bar">
        <span class="preview__type">{artifact.type}</span>
        {roleLabel && <span class="preview__role">{roleLabel}</span>}
        {hostIsEmbeddable && hasUrl && <span class="preview__embeddable">embed</span>}
      </div>
      <div class="preview__body">
        {
          artifact.previewImage ? (
            <img
              class="preview__image"
              src={artifact.previewImage}
              alt={artifact.title}
              loading="lazy"
            />
          ) : (
            <div class="preview__thumbnail" aria-hidden="true">
              <span class="preview__thumbnail-type">{artifact.type}</span>
              <span class="preview__thumbnail-label">Preview</span>
            </div>
          )
        }
        <h3 class="preview__title">{artifact.title}</h3>
        <p class="preview__desc">{artifact.description}</p>
        <div class="preview__foot">
          <span class="preview__status" data-status={evidenceStatus}>
            <span class="preview__dot" aria-hidden="true"></span>
            {evidenceStatusLabel(evidenceStatus)}
          </span>
          <button class="preview__action preview__action--filled" type="button" data-show-evidence>
            Show evidence
          </button>
        </div>
        {
          hasUrl ? (
            <a class="preview__action preview__action--external" href={artifact.url} target="_blank" rel={externalRel}>
              Open artifact <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <span class="preview__action preview__action--pending" title="No artifact URL supplied yet">
              Link pending
            </span>
          )
        }
      </div>

      <div class="preview__embed-target" data-evidence-target hidden></div>
      <p class="preview__pending" data-evidence-pending hidden>
        No evidence URL supplied yet. This item stays in preview until the owner supplies the asset.
      </p>
    </article>
  )
}

<style>
  .preview {
    border: var(--rule);
    border-radius: var(--radius-2);
    padding: var(--space-5);
    background: var(--bg-elevated);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25); /* subtle, artifact previews only (§35) */
  }

  .preview--link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
  }

  .preview--link .preview__status {
    margin-left: auto;
  }

  .preview--embed {
    padding: 0;
    overflow: hidden;
  }

  .preview__bar {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .preview__body {
    padding: var(--space-5);
  }

  .preview--embed .preview__body {
    padding: var(--space-5);
  }

  .preview__type {
    font-size: var(--fs-card-status);
    font-weight: 600;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--gold-bright);
  }

  .preview__role {
    font-size: var(--fs-card-status);
    font-weight: 500;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .preview__embeddable {
    font-size: var(--fs-card-status);
    font-weight: 500;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--green-bright);
    margin-left: auto;
  }

  .preview__image {
    width: 100%;
    height: auto;
    border: var(--rule);
    border-radius: var(--radius-1);
    margin: 0 0 var(--space-4);
  }

  .preview__thumbnail {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 132px;
    margin: 0 0 var(--space-4);
    border: var(--rule);
    border-radius: var(--radius-1);
    background: var(--bg);
    color: var(--text-faint);
  }

  .preview__thumbnail-type {
    font-family: var(--font-heading);
    font-size: var(--fs-card-status);
    font-weight: 600;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .preview__thumbnail-label {
    font-size: var(--fs-card-metadata);
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
  }

  .preview__title {
    font-size: var(--fs-card-title);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .preview__desc {
    font-size: var(--fs-card-description);
    color: var(--text-dim);
    margin: 0 0 var(--space-4);
  }

  .preview__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-top: var(--rule);
    padding-top: var(--space-4);
  }

  .preview__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-card-status);
    font-weight: 500;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .preview__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--graph-grey);
    flex-shrink: 0;
  }

  .preview__status[data-status='available'] .preview__dot {
    background: var(--green-bright);
  }
  .preview__status[data-status='partial'] .preview__dot {
    background: var(--gold);
  }
  .preview__status[data-status='private'] .preview__dot,
  .preview__status[data-status='missing'] .preview__dot {
    background: var(--terracotta);
  }

  .preview__action {
    font-size: var(--fs-card-action);
    font-weight: 600;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    border: 0;
    background: transparent;
    padding: 0;
  }

  .preview__action--filled {
    padding: var(--space-2) var(--space-3);
    border: var(--rule-active);
    border-radius: var(--radius-1);
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
    cursor: pointer;
  }

  .preview__action--filled:hover {
    background: var(--green-bright);
    border-color: var(--green-bright);
    color: var(--bg);
  }

  .preview__action--external {
    display: inline-block;
    margin-top: var(--space-4);
  }

  .preview__action--pending {
    color: var(--text-faint);
    cursor: default;
    border: 0;
    background: transparent;
  }

  .preview__pending {
    font-size: var(--fs-card-metadata);
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--text-faint);
    margin: var(--space-3) 0 0;
  }

  .preview__link-title {
    color: var(--text);
    font-size: var(--fs-card-title);
    flex: 1;
  }

  .embed-fallback {
    padding: var(--space-5);
    border-top: var(--rule);
    background: var(--bg);
  }

  .embed-fallback__note {
    color: var(--text-faint);
    font-size: var(--fs-card-metadata);
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
  }

  .embed-fallback .preview__foot {
    border-top: 0;
    padding-top: 0;
  }

  .preview__embed-target {
    border-top: var(--rule);
  }

  .preview--is-revealed .embed-fallback {
    display: none;
  }

  .preview__embed-target iframe,
  .preview__embed-target video,
  .preview__embed-target object {
    width: 100%;
    height: 520px;
    border: 0;
    display: block;
    background: var(--bg);
  }
</style>
