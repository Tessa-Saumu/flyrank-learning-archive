---
/**
 * NotebookPreview.astro — a contained, integrated ML notebook viewport
 * (DESIGN_SPEC §22–23). NOT an iframe.
 *
 * Dark technical frame: compact title bar, one row per executed notebook
 * (filename + one-sentence outcome + OPEN NOTEBOOK action), a results region
 * (metric table when the committed output files carry one; charts and code
 * excerpts attach per notebook when exported) and a GitHub repository action.
 *
 * All links are the real, public notebooks in the FlyRank ML internship
 * repository (CONTENT_REGISTRY §3.4); the metric rows are the author's
 * committed output files, copied verbatim (see src/data/notebooks.ts).
 */
import { evidenceStatusLabel } from '../lib/archive';
import type { NotebookPreview } from '../data/notebooks';
import type { EvidenceStatus } from '../data/types';

interface Props {
  notebook: NotebookPreview;
  evidenceStatus?: EvidenceStatus;
}

const { notebook, evidenceStatus = 'partial' } = Astro.props;
const count = notebook.notebooks.length;
const plural = count === 1 ? 'notebook' : 'notebooks';
---

<article class="nb" aria-label={`${count} ${plural} for this assignment`}>
  <header class="nb__bar">
    <span class="nb__dot" aria-hidden="true"></span>
    <span class="nb__file">Notebooks · {count}</span>
    <span class="nb__status" data-status={evidenceStatus}>
      {evidenceStatusLabel(evidenceStatus)}
    </span>
  </header>

  <div class="nb__body">
    <div class="nb__list">
      {
        notebook.notebooks.map((nb) => (
          <div class="nb__row">
            <div class="nb__row-head">
              <code class="nb__name">{nb.filename}</code>
              <a
                class="nb__open"
                href={nb.openUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open ${nb.filename} on GitHub`}
              >
                Open <span aria-hidden="true">↗</span>
              </a>
            </div>
            <p class="nb__row-outcome">{nb.outcome}</p>
          </div>
        ))
      }
    </div>

    <div class="nb__results">
      {
        notebook.hasEvidence ? (
          <>
            {notebook.charts.length > 0 && (
              <div class="nb__charts">
                {notebook.charts.map((src) => (
                  <figure class="nb__chart">
                    <img src={src} alt={`${notebook.notebooks[0].filename} chart`} loading="lazy" />
                  </figure>
                ))}
              </div>
            )}
            {notebook.metrics.length > 0 && (
              <table class="nb__table">
                <caption class="nb__table-caption">Committed output metrics</caption>
                <thead>
                  <tr>
                    <th>Metric</th>
                    <th>Value</th>
                  </tr>
                </thead>
                <tbody>
                  {notebook.metrics.map((m) => (
                    <tr>
                      <td>{m.label}</td>
                      <td>{m.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {notebook.code && <pre class="nb__code"><code>{notebook.code}</code></pre>}
          </>
        ) : (
          <p class="nb__pending">
            The chart images and the code excerpt attach here when the notebook
            evidence is exported. The executed notebooks themselves are linked
            above.
          </p>
        )
      }
    </div>
  </div>

  <footer class="nb__actions">
    <a class="nb__action nb__action--primary" href={notebook.githubUrl} target="_blank" rel="noopener noreferrer">
      GitHub repository <span aria-hidden="true">↗</span>
    </a>
  </footer>
</article>

<style>
  .nb {
    border: var(--rule);
    border-radius: var(--radius-2);
    background: var(--bg-elevated);
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25); /* subtle, artifact previews only (§35) */
  }

  .nb__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border-bottom: var(--rule);
    background: var(--bg);
  }

  .nb__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green-bright);
    flex-shrink: 0;
  }

  .nb__file {
    font-family: var(--font-heading);
    font-size: var(--fs-metadata);
    font-weight: 600;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
  }

  .nb__status {
    margin-left: auto;
    font-size: var(--fs-metadata);
    font-weight: 500;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--gold);
  }

  .nb__status[data-status='available'] {
    color: var(--green-text);
  }

  .nb__body {
    padding: var(--space-5);
  }

  .nb__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .nb__row-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }

  .nb__name {
    font-size: var(--fs-metadata);
    font-weight: 600;
    color: var(--text);
    word-break: break-all;
  }

  .nb__open {
    font-size: var(--fs-metadata);
    font-weight: 600;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    padding: var(--space-1) var(--space-2);
    border: var(--rule-active);
    border-radius: var(--radius-1);
  }

  .nb__open:hover {
    background: var(--green-bright);
    border-color: var(--green-text);
    color: var(--bg);
  }

  .nb__row-outcome {
    color: var(--text-dim);
    font-size: var(--fs-card-description);
    margin: 0;
    max-width: var(--measure);
  }

  .nb__results {
    border: var(--rule);
    border-radius: var(--radius-1);
    padding: var(--space-4);
    background: var(--bg);
  }

  .nb__charts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .nb__chart {
    margin: 0;
    border: var(--rule);
    border-radius: var(--radius-1);
    padding: var(--space-2);
    background: var(--bg-elevated);
  }

  .nb__chart img {
    width: 100%;
    height: auto;
  }

  .nb__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-metadata);
    margin-bottom: var(--space-4);
  }

  .nb__table-caption {
    caption-side: top;
    text-align: left;
    font-size: var(--fs-card-status);
    font-weight: 600;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--text-faint);
    padding-bottom: var(--space-2);
  }

  .nb__table th,
  .nb__table td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--rule);
  }

  .nb__table th {
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 600;
  }

  .nb__table td:last-child {
    font-weight: 600;
    text-align: right;
  }

  .nb__code {
    background: var(--bg);
    border: var(--rule);
    border-radius: var(--radius-1);
    padding: var(--space-3);
    overflow-x: auto;
    font-size: 11px;
    line-height: 1.5;
    color: var(--text-dim);
    margin: 0;
  }

  .nb__pending {
    color: var(--text-faint);
    font-size: var(--fs-body);
    margin: 0;
    max-width: var(--measure);
  }

  .nb__actions {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-top: var(--rule);
  }

  .nb__action {
    font-size: var(--fs-metadata);
    font-weight: 600;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
    padding: var(--space-2) var(--space-3);
    border: var(--rule-active);
    border-radius: var(--radius-1);
  }

  .nb__action--primary {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .nb__action--primary:hover {
    background: var(--green-bright);
    border-color: var(--green-bright);
    color: var(--bg);
  }
</style>
