---
/**
 * AssignmentCard.astro — tier-weighted archive card (DESIGN_SPEC §12, §47).
 *
 * V2 §2/§5: a card click opens the assignment in an in-context modal while the
 * `href` remains available for no-JS and direct linking. The card uses the
 * canonical V2 assignment-card typography tokens; tier weight is expressed with
 * contrast/opacity/border, never one-off font-size overrides.
 */
import { displayLabel, metadataLine } from '../lib/archive';
import type { Assignment } from '../data/types';

interface Props {
  assignment: Assignment;
}

const { assignment: a } = Astro.props;
const href = `/work/${a.id}/`;
---

<a
  class:list={['acard', `acard--${a.tier}`, `track-${a.track}`]}
  href={href}
  data-assignment-card
  data-assignment-id={a.id}
  aria-haspopup="dialog"
>
  <span class="acard__code">{displayLabel(a)}</span>
  <span class="acard__meta">{metadataLine(a)}</span>
  <span class="acard__title">{a.title}</span>
</a>

<style>
  .acard {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: var(--rule);
    border-radius: var(--radius-2);
    text-decoration: none;
    color: var(--text);
    background: transparent;
    transition: border-color var(--motion-hover) var(--ease), background var(--motion-hover) var(--ease);
    min-height: 100%;
  }

  .acard:hover {
    border-color: var(--rule-active);
    background: var(--bg-elevated);
  }

  /* Canonical V2 assignment-card typography (V2_IMPROVEMENT_SPEC §5). */
  .acard__code {
    font-family: var(--font-heading);
    font-size: var(--fs-card-label);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .acard__meta {
    font-size: var(--fs-card-metadata);
    font-weight: 500;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .acard__title {
    font-size: var(--fs-card-title);
    line-height: 1.4;
    color: var(--text-dim);
  }

  /* Tier weighting (DESIGN_SPEC §47): contrast/opacity, never font size. */
  .acard--core {
    border-color: var(--rule-active);
  }
  .acard--core .acard__code {
    color: var(--text);
  }
  .acard--core .acard__title {
    color: var(--text);
  }

  .acard--supporting .acard__code {
    color: var(--text-dim);
  }

  .acard--reference {
    opacity: 0.72;
  }
  .acard--reference .acard__code {
    color: var(--text-dim);
    font-weight: 500;
  }

  /* Track accent (paired with text label, never colour alone) */
  .acard.track-ai-fluency .acard__meta {
    color: var(--green-bright);
  }
  .acard.track-machine-learning .acard__meta {
    color: var(--terracotta);
  }
</style>
