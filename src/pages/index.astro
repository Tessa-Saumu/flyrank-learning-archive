---
/**
 * Homepage — intro + Learning Map + orientation + browse index.
 *
 * Phase 2 composition (DESIGN_SPEC §03, §53): on desktop the intro sits in a
 * left column beside the interactive Learning Map (map centre, detail panel
 * right when something is selected). Below, the orientation section and the
 * full browse index remain the guaranteed non-graph route (DESIGN_SPEC §39, §58).
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LearningMap from '../components/LearningMap.astro';
import FilterBar from '../components/FilterBar.astro';
import BrowseWork from '../components/BrowseWork.astro';
import { assignments } from '../data/assignments';
---

<Base>
  <section class="map-section" id="map" aria-labelledby="map-heading">
    <div class="container">
      <div class="map-section__grid">
        <div class="map-section__intro">
          <h2 class="sr-only" id="map-heading">Learning map</h2>
          <Hero />
        </div>
        <div class="map-section__stage">
          <LearningMap />
        </div>
      </div>
    </div>
  </section>

  <section class="orientation section" aria-labelledby="orientation-heading">
    <div class="container">
      <h2 class="sr-only" id="orientation-heading">Orientation</h2>
      <div class="orientation__grid">
        <div class="orientation__item">
          <h3 class="orientation__label">What this is</h3>
          <p>
            A visual archive of the work completed across the FlyRank AI
            Fluency and Machine Learning tracks: what each assignment asked
            for, what it taught, and how the pieces connect.
          </p>
        </div>
        <div class="orientation__item">
          <h3 class="orientation__label">Who it is for</h3>
          <p>
            Future FlyRank students who want to see what the programme actually
            asks, and reviewers who want to see the work and how it fits
            together.
          </p>
        </div>
        <div class="orientation__item">
          <h3 class="orientation__label">How to use it</h3>
          <p>
            Explore the map, or browse the work below and filter by track,
            tier, and concept. Every assignment links to its task, lesson,
            takeaway, and proof.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="browse" aria-labelledby="browse-heading">
    <div class="container">
      <h2 class="section-label" id="browse-heading">Browse the work</h2>
      <FilterBar basePath="/work/" />
      <BrowseWork assignments={assignments} searchId="home-search" />
    </div>
  </section>
</Base>

<style>
  .map-section {
    padding: var(--space-7) 0 var(--space-6);
  }

  .map-section__grid {
    display: grid;
    grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }

  @media (max-width: 1023px) {
    .map-section__grid {
      grid-template-columns: 1fr;
    }
  }

  .orientation__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-6);
  }

  .orientation__label {
    font-family: var(--font-heading);
    font-size: var(--fs-metadata);
    font-weight: 600;
    letter-spacing: var(--tracking-metadata);
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: var(--space-2);
  }

  .orientation__item p {
    color: var(--text-dim);
    margin: 0;
  }
</style>
