---
/**
 * /reflection — stub. The final retrospective (500–800 words) lands in
 * Phase 3 once written by the programme author. No invented reflection
 * before then (PRODUCT_SPEC §32).
 */
import Base from '../layouts/Base.astro';
---

<Base
  title="Reflection"
  description="Final reflection for the FlyRank Learning Archive."
  canonicalPath="/reflection/"
>
  <div class="container section">
    <p class="eyebrow">Reflection</p>
    <h1 class="stub__title">Final Reflection</h1>
    <p class="stub__body">
      This section is being written from the completed work. It will appear in
      the final phase as a 500 to 800 word retrospective aimed at the person
      who was in Week 1.
    </p>
  </div>
</Base>

<style>
  .stub__title {
    font-size: var(--fs-assignment);
    font-weight: 600;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .stub__body {
    color: var(--text-dim);
    max-width: var(--measure-narrow);
  }
</style>
